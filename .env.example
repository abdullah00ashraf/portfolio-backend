# Django Academic & Portfolio Core Environment Configuration Template
# Copy this file to .env and configure for local development or deployment.
# NEVER commit real production secrets or .env to version control.

# Core Django Security Settings
SECRET_KEY=generate_a_secure_random_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cryptography & Security Plugins
CRYPTOGRAPHY_KEY=your_secure_aes_encryption_key_here

# Google Drive API Service Integration (for credential document storage)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=credentials/google_drive_key.json

# Database Configuration (Defaults to local db.sqlite3)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
