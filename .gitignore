# Credentials isolation (Protects Google Service Account JSON keys)
credentials/*
!credentials/*.example
google_credentials.json

# Local Python Environment & Caches
venv/
.venv/
*.pyc
__pycache__/
.pytest_cache/

# Databases
db.sqlite3
*.sqlite
*.sqlite3

# Media and Static files
media/
static/
staticfiles/

# System and editor caches
.idea/
.vscode/
.DS_Store
Thumbs.db

# Environment variables & Key files
.env
.env.*
!.env.example
*.json.key
